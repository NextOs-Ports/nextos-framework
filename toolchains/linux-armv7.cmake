set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7)
if(NOT DEFINED ENV{NEXTOS_ARMV7_CC} OR NOT DEFINED ENV{NEXTOS_SYSROOT})
  message(FATAL_ERROR "Set NEXTOS_ARMV7_CC and NEXTOS_SYSROOT to your verified Linux ARMHF cross toolchain")
endif()
set(CMAKE_C_COMPILER "$ENV{NEXTOS_ARMV7_CC}")
set(CMAKE_SYSROOT "$ENV{NEXTOS_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
