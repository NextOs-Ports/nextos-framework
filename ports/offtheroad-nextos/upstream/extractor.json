{
  "schema": 1,
  "id": "offtheroad-nextos",
  "version": "1.18.2-arm64-4",
  "title": "OFF THE ROAD",
  "abi_order": [
    "arm64-v8a"
  ],
  "input": {
    "search_dirs": [
      "gamedata",
      "."
    ],
    "prefer_first_nonempty": true,
    "sniff_all_in_primary": true,
    "max_files": 64,
    "max_bundle_apks": 64,
    "max_member_bytes": 3221225472,
    "max_bundle_bytes": 6442450944,
    "packages": [
      "com.dogbytegames.offtheroad"
    ]
  },
  "extract": [
    {
      "id": "engine-libgame-arm64",
      "comment": "O adapter depende do ABI/import set medido deste payload interno. O hash e o tamanho autenticam libgame.so, nao o container APK; assinatura, nome e reempacotamento do container continuam irrelevantes.",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libgame.so"
        ]
      },
      "destination": "lib/libgame.so",
      "validate": {
        "type": "file",
        "elf_machine": "{abi}",
        "size": 9501104,
        "sha256": "5258d644cbb023b137719901fa84acf8a8ae3da01c573b52a7a31255245628dd"
      }
    },
    {
      "id": "android-libcpp-shared-arm64",
      "comment": "Runtime C++ Android autenticado separadamente do container para preservar o namespace std::__ndk1 usado pelo guest medido.",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libc++_shared.so"
        ]
      },
      "destination": "lib/libc++_shared.so",
      "validate": {
        "type": "file",
        "elf_machine": "{abi}",
        "size": 1292904,
        "sha256": "4397241b4bd20a8e579bfb41d21107857e12985f6a01ca0c2a5f83380d1270b4"
      }
    },
    {
      "id": "game-data-assets",
      "comment": "A engine abre os dados por AAssetManager_open, e o shim do loader serve isso a partir de ./assets/. A arvore assets/ do APK cai em assets/ com o prefixo removido: os data_%03d.xpk (~520 MB), a musica .ogg e, quando a build traz, AVConfig.json e ad-viewer/. So data_001.xpk e' requisito: a QUANTIDADE de xpk, o AVConfig.json (config de ads) e os .js variam por build, e o shim devolve NULL para asset ausente (mesma semantica do Android).",
      "source": {
        "kind": "entries",
        "patterns": [
          "assets/**"
        ],
        "strip_prefix": "assets/"
      },
      "destination": "assets",
      "validate": {
        "type": "tree",
        "min_files": 12,
        "max_files": 400,
        "min_bytes": 300000000,
        "max_bytes": 2000000000,
        "required_paths": [
          "data_001.xpk"
        ]
      }
    }
  ],
  "validate": [
    {
      "path": "lib/libgame.so",
      "type": "file",
      "elf_machine": "{abi}",
      "size": 9501104,
      "sha256": "5258d644cbb023b137719901fa84acf8a8ae3da01c573b52a7a31255245628dd"
    },
    {
      "path": "lib/libc++_shared.so",
      "type": "file",
      "elf_machine": "{abi}",
      "size": 1292904,
      "sha256": "4397241b4bd20a8e579bfb41d21107857e12985f6a01ca0c2a5f83380d1270b4"
    },
    {
      "path": "assets/data_001.xpk",
      "type": "file",
      "min_size": 1000000,
      "max_size": 500000000
    },
    {
      "path": "assets",
      "type": "tree",
      "min_files": 12
    }
  ],
  "commit": [
    "lib",
    "assets"
  ],
  "reference_build": {
    "game_version": "1.18.2",
    "container_size": 563848921,
    "container_sha256": "9e24980ff7fa31e741dc4f03806386bd09c47a60eb4c46b2b41f3403c97f5976",
    "note": "Documentation only; compatibility is decided by package, ABI, structure and authenticated internal runtime payloads."
  },
  "compatibility": {
    "package_families": [
      "com.dogbytegames.offtheroad"
    ],
    "abis": [
      "arm64-v8a"
    ],
    "required_members": [
      {
        "member": "lib/arm64-v8a/libgame.so",
        "role": "variant_required",
        "variant": "arm64-v8a"
      },
      {
        "member": "lib/arm64-v8a/libc++_shared.so",
        "role": "variant_required",
        "variant": "arm64-v8a"
      },
      {
        "member": "assets/data_001.xpk",
        "role": "core_required"
      },
      {
        "member": "assets/AVConfig.json",
        "role": "optional"
      }
    ],
    "payload_contracts": [
      "libgame.so is the measured ELF64 AArch64 xGen/bgfx runtime consumed by the adapter",
      "libc++_shared.so provides the measured Android std::__ndk1 namespace",
      "assets/data_001.xpk is required while optional advertising assets may vary"
    ],
    "required_symbols_or_interfaces": [
      "libgame.so direct EGL import inventory recorded by egl-import-contract-v1",
      "Cocos JNI lifecycle and native gamepad exports recorded by adapter-contract"
    ]
  }
}
