  "persistence": {
    "callbacks": [
      "PlayerPrefs (asynchronous apply, flushed on nativePause and exit)",
      "savedGames.gd through the Android file API"
    ],
    "paths": [
      "home/"
    ]
  },
  "prohibitions": [
    "do not skip or reorder the native Unity lifecycle",
    "do not vendor or preload a private SDL",
    "do not accept an APK only by whole-container SHA-256",
    "do not treat audio or a live PID as video proof",
    "do not publish generation health before successful real presents",
    "do not exit on any chord other than SELECT+START",
    "do not convert controller input into keyboard keys",
    "do not scan input nodes, open an unassociated raw joystick, or derive button presses from evdev ordinals",
    "do not let menu pointer input leak into gameplay; A clicks only in a proven menu context"
  ],
  "quirks": [
    "Play Asset Delivery pack datapack.unity3d is unbundled during extraction into the loose serialized layout the engine already probes; nothing is reserialized",
    "the Play licensing gate is answered locally through the game's own LicensingServiceCallback proxy (allow with an empty payload)",
    "Unity 6 GLES3 requests are bridged to the real GLES2 context (gles3.c + essl1.c) and ETC2/ASTC uploads are decoded in software",
    "PlayerPrefs apply() is asynchronous as on Android: memory is the truth, disk is written on nativePause, exit and at most every 15 s",
    "JNI local references die at the frame boundary; global references are counted and reclaimed objects become tombstones",
    "the pointer arrow is drawn by geometry inside the swap, after the Unity frame; the first-boot SELECT CONTROLS TYPE box is answered with it",
    "controls: NEXTOS_CONTROLLERS/4 live in front of Android input; proven menus use right-stick pointer plus R3 click and native A confirmation, while gameplay restores native A/right-stick/R3; D-pad uses one Android KeyEvent route with neutral HAT in every context, contradictory pairs are cancelled, and an exact-device kernel snapshot can only erase conclusively stale SDL button/stick state",
    "a pending nxbootstrap generation receives its atomic mode-0600 ready receipt only after 30 successful real page flips on the active SDL or raw-EGL backend",
    "video V5: auto is the total stretch algorithm on every drawable; preserve is an explicit owner choice that centers the same 16:9 source with opaque bars"
  ],
  "release_ready": true,
  "schema": "nxadapter-skeleton-v1",
  "schema_version": 1,
  "status": "implemented_release",
  "terminal": {
    "action": "SELECT+START (nxinput_exit_chord) requests the native lifecycle shutdown: nativeFocusChanged(false), nativePause (writes the save), PlayerPrefs flush, _exit(0)",
    "evidence": [
      "src/input.c",
      "src/main.c"
    ]
  },
