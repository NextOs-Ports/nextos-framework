      "libmain.JNI_OnLoad",
      "NativeLoader.load(libunity.so)",
      "libunity.init_array",
      "libunity.JNI_OnLoad",
      "NativeLoader.load(libil2cpp.so)",
      "libil2cpp.init_array",
      "libil2cpp.JNI_OnLoad",
      "UnityPlayer.initJni(contextType=0)",
      "nativeRecreateGfxState(surfaceCreated)",
      "nativeRecreateGfxState(surfaceChanged)",
      "nativeSendSurfaceChangedEvent",
      "nativeFocusChanged(true)",
      "nativeResume",
      "nxinput.c6.admit-before-announce",
      "nxinput.gptk.live-seal",
      "nativeRender",
      "nxgl.graphics.pre-present",
      "nxgl.frame-proof.sample-before-present",
      "SDL_GL_SwapWindow|eglSwapBuffers",
      "nxgl.graphics.after-present",
      "nxbootstrap.health.ready-after-30-real-presents",
      "nativeFocusChanged(false)",
      "nativePause",
      "nxgl.frame-proof.publish",
      "PlayerPrefs.flush",
      "_exit"
