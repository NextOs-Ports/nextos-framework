        "wall_seconds": 1800,
        "cpu_seconds": 1800,
        "memory_bytes": 536870912,
        "fsize_bytes": 8589934592
      },
      "contract": {
        "schema": "org.nextos.apk-compat.hook-contract",
        "schema_version": 1,
        "hook_id": "sallyface-unbundle",
        "inputs": [
          "assets/bin/Data/datapack.unity3d"
        ],
        "predicates": [
          {
            "class": "compatibility",
            "checks": "o asset pack e um bundle UnityFS legivel: o desmontador le o cabecalho, percorre os nos e grava cada entrada; qualquer build cujo pack nao abra falha aqui, sem olhar nome, tamanho ou hash do container"
          },
          {
            "class": "compatibility",
            "checks": "a desmontagem tem de aumentar a contagem de entradas da arvore assets/bin/Data; um pack que produza zero entradas novas e recusado"
          },
          {
            "class": "patch_selection",
            "checks": "perfis conhecidos sao escolhidos somente pelos hashes dos payloads internos data.unity3d e datapack.unity3d autenticados pelo NXExtract; payload desconhecido segue generic-pass-through sem transformacao cega"
          },
          {
            "class": "compatibility",
            "checks": "o hook publica por ultimo um recibo persistente arm64-4; instalacoes arm64-3 sem esse recibo nao podem ser adotadas e precisam ser reconstruidas a partir dos dados legitimos do dono"
          }
        ],
        "fallback": "generic-pass-through",
        "error_codes": [
          "NXE7001"
        ]
      }
    }
  ],
