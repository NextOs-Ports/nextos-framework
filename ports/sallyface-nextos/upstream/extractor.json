  "hooks": [
    {
      "id": "sallyface-unbundle",
      "argv": [
        "python3",
        "-B",
        "{game_dir}/nxextract/sf_prepare.py",
        "{stage}",
        "{game_dir}"
      ],
      "cwd": "{game_dir}",
      "checkpoint": [
        {
          "path": "assets/.sallyface-prepare-arm64-4.json",
          "type": "file",
          "min_size": 121,
          "max_size": 130,
          "sha256": [
            "d8c3469830329398c529f478f67c1261dc85b31dc7ff5e88d652c56676c46bcb",
            "8f18b7b4c01e9772325d31691c47fa4b55d034680e93961c410a43fc0140b666",
            "4e0b83b05bf6cfc2b7542cebfc08acf318e8f3cebdeccd62e7126d048e3f3f4c"
          ]
        },
        {
          "path": "assets/bin/Data/boot.config",
          "type": "file",
          "min_size": 8
