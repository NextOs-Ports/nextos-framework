{
  "schema": 1,
  "id": "summertimesaga",
  "version": "21-compatible-1",
  "title": "SUMMERTIME SAGA",
  "abi_order": [
    "arm64-v8a"
  ],
  "input": {
    "search_dirs": [
      "gamedata",
      "."
    ],
    "prefer_first_nonempty": true,
    "sniff_all_in_primary": true,
    "max_files": 64,
    "max_bundle_apks": 64,
    "max_member_bytes": 4294967296,
    "max_bundle_bytes": 8589934592
  },
  "extract": [
    {
      "id": "renpython",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/librenpython.so"
        ]
      },
      "destination": "librenpython.so",
      "validate": {
        "type": "file",
        "min_size": 20971520,
        "max_size": 104857600,
        "magic_hex": "7f454c46",
        "elf_machine": "{abi}"
      }
    },
    {
      "id": "android-assets",
      "source": {
        "kind": "entries",
        "patterns": [
          "assets/**"
        ],
        "strip_prefix": "assets/"
      },
      "destination": "assets",
      "validate": {
        "type": "tree",
        "min_files": 20000,
        "max_files": 100000,
        "min_bytes": 1000000000,
        "max_bytes": 4294967296,
        "required_paths": [
          "private.mp3",
          "x-android.json",
          "x-game/x-changelog.txt",
          "x-game/x-mvps.txt",
          "x-game/x-saga/x-__init__.pyc",
          "x-game/x-script_version.txt",
          "x-renpy/x-common/x-00start.rpyc"
        ]
      }
    }
  ],
  "hooks": [
    {
      "id": "prepare-runtime-data",
      "argv": [
        "python3",
        "{game_dir}/tools/prepare_summertime_data.py"
      ],
      "cwd": "{game_dir}",
      "checkpoint": [
        {
          "path": "lib/python3.12",
          "type": "tree",
          "min_files": 500,
          "max_files": 5000,
          "min_bytes": 5242880,
          "max_bytes": 268435456,
          "required_paths": [
            "__future__.pyc",
            "encodings/__init__.pyc",
            "os.pyc",
            "site.pyc",
            "sitecustomize.pyc"
          ]
        },
        {
          "path": "saga",
          "type": "tree",
          "min_files": 400,
          "max_files": 2000,
          "min_bytes": 1000000,
          "max_bytes": 33554432,
          "required_paths": [
            "__init__.pyc",
            "event.pyc",
            "init/logic.py",
            "init/logic.pyc",
            "init/sound.py",
            "init/sound.pyc",
            "logic/prologue.pyc"
          ]
        },
        {
          "path": ".summertime-data.json",
          "type": "file",
          "min_size": 200,
          "max_size": 4096,
          "magic_ascii": "{"
        }
      ]
    }
  ],
  "validate": [
    {
      "path": "lib/python3.12",
      "type": "tree",
      "min_files": 500,
      "max_files": 5000,
      "min_bytes": 5242880,
      "max_bytes": 268435456,
      "required_paths": [
        "__future__.pyc",
        "encodings/__init__.pyc",
        "os.pyc",
        "site.pyc",
        "sitecustomize.pyc"
      ]
    },
    {
      "path": "assets/x-game/.summertime-index.txt",
      "type": "file",
      "min_size": 1000000,
      "max_size": 8388608
    },
    {
      "path": "saga",
      "type": "tree",
      "min_files": 400,
      "max_files": 2000,
      "min_bytes": 1000000,
      "max_bytes": 33554432,
      "required_paths": [
        "__init__.pyc",
        "event.pyc",
        "init/logic.py",
        "init/logic.pyc",
        "init/sound.py",
        "init/sound.pyc",
        "logic/prologue.pyc"
      ]
    },
    {
      "path": ".summertime-data.json",
      "type": "file",
      "min_size": 200,
      "max_size": 4096,
      "magic_ascii": "{"
    }
  ],
  "commit": [
    "librenpython.so",
    "lib",
    "assets",
    "saga",
    ".summertime-data.json"
  ],
  "marker": ".nxextract-summertimesaga.json",
  "space": {
    "safety_bytes": 268435456
  },
  "log": "nxextract.log",
  "ui_success_seconds": 1,
  "ui_error_seconds": 8
}
