{
  "schema": 1,
  "id": "terraria-nextos",
  "version": "1.4.5.6.4-universal-2",
  "title": "TERRARIA",
  "abi_order": [
    "arm64-v8a"
  ],
  "input": {
    "search_dirs": [
      "gamedata",
      "."
    ],
    "prefer_first_nonempty": true,
    "sniff_all_in_primary": true,
    "max_files": 64,
    "max_bundle_apks": 64,
    "max_member_bytes": 268435456,
    "max_bundle_bytes": 536870912
  },
  "extract": [
    {
      "id": "unity-data",
      "source": {
        "kind": "entries",
        "patterns": [
          "assets/bin/**"
        ],
        "strip_prefix": "assets/bin/"
      },
      "destination": "bin",
      "validate": {
        "type": "tree",
        "min_files": 6,
        "max_files": 64,
        "min_bytes": 83886080,
        "max_bytes": 629145600,
        "required_paths": [
          "Data/boot.config",
          "Data/data.unity3d",
          "Data/Managed/Metadata/global-metadata.dat",
          "Data/resources.resource",
          "Data/unity default resources"
        ]
      }
    },
    {
      "id": "android-libunity",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libunity.so"
        ]
      },
      "destination": "libunity.so",
      "validate": {
        "type": "file",
        "min_size": 6291456,
        "max_size": 67108864,
        "elf_machine": "{abi}"
      }
    },
    {
      "id": "android-libil2cpp",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libil2cpp.so"
        ]
      },
      "destination": "libil2cpp.so",
      "validate": {
        "type": "file",
        "min_size": 20971520,
        "max_size": 268435456,
        "elf_machine": "{abi}"
      }
    },
    {
      "id": "android-libcxx",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libc++_shared.so"
        ]
      },
      "destination": "libc++_shared.so",
      "validate": {
        "type": "file",
        "min_size": 131072,
        "max_size": 16777216,
        "elf_machine": "{abi}"
      }
    }
  ],
  "hooks": [
    {
      "id": "validate-and-patch-unity-boot",
      "argv": [
        "python3",
        "{game_dir}/tools/prepare_terraria_data.py",
        "--stage",
        "{stage}",
        "--game-dir",
        "{game_dir}"
      ],
      "cwd": "{game_dir}",
      "checkpoint": [
        {
          "path": ".terraria-data.json",
          "type": "file",
          "min_size": 200,
          "max_size": 65536,
          "magic_ascii": "{"
        },
        {
          "path": "bin/Data/boot.config",
          "type": "file",
          "min_size": 80,
          "max_size": 8192
        }
      ]
    }
  ],
  "validate": [
    {
      "path": ".terraria-data.json",
      "type": "file",
      "min_size": 200,
      "max_size": 65536,
      "magic_ascii": "{"
    },
    {
      "path": "bin",
      "type": "tree",
      "min_files": 6,
      "max_files": 64,
      "min_bytes": 83886080,
      "max_bytes": 629145600,
      "required_paths": [
        "Data/boot.config",
        "Data/data.unity3d",
        "Data/Managed/Metadata/global-metadata.dat",
        "Data/resources.resource",
        "Data/unity default resources"
      ]
    },
    {
      "path": "bin/Data/boot.config",
      "type": "file",
      "min_size": 80,
      "max_size": 8192
    },
    {
      "path": "bin/Data/data.unity3d",
      "type": "file",
      "min_size": 20971520,
      "max_size": 419430400,
      "magic_ascii": "UnityFS"
    },
    {
      "path": "bin/Data/Managed/Metadata/global-metadata.dat",
      "type": "file",
      "min_size": 2097152,
      "max_size": 67108864
    },
    {
      "path": "libunity.so",
      "type": "file",
      "min_size": 6291456,
      "max_size": 67108864,
      "elf_machine": "arm64-v8a"
    },
    {
      "path": "libil2cpp.so",
      "type": "file",
      "min_size": 20971520,
      "max_size": 268435456,
      "elf_machine": "arm64-v8a"
    },
    {
      "path": "libc++_shared.so",
      "type": "file",
      "min_size": 131072,
      "max_size": 16777216,
      "elf_machine": "arm64-v8a"
    }
  ],
  "commit": [
    "bin",
    "libunity.so",
    "libil2cpp.so",
    "libc++_shared.so",
    ".terraria-data.json"
  ],
  "marker": ".nxextract-terraria.json",
  "space": {
    "safety_bytes": 268435456
  },
  "log": "nxextract.log",
  "ui_success_seconds": 1,
  "ui_error_seconds": 8
}
