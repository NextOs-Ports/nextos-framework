 		int total = 0;
 
 		while (todo && !ad->exit_thread.is_set()) {
+#ifdef FBDEV_ENABLED
+			// Do not poll a nonblocking PCM in a tight loop, and do not hold the
+			// AudioServer mutex while ALSA waits for room. Apart from wasting a
+			// CPU, the old loop could keep setup/shutdown blocked forever after
+			// an XRUN because snd_pcm_recover() returns zero without consuming
