  "lifecycle": {
    "sequence": [
      "launcher verifies authenticated generation and owner-data gate",
      "NXExtract materializes the owner APK payload when absent",
      "canonical five-second NXSplash",
      "port-env selects the GLES2 shim facade and firmware SDL provider",
      "Godot main initializes the packed project and managed runtime",
      "SDL gamepad admission applies nxinput normalization before announcement",
      "GPTK owner/default mapping loads and ACK sinks seal",
      "the first admitted single-player pad becomes the only GPTK owner while additional pads retain native device identity",
      "current Tearscape scene plus its UiManager-owned SceneTree paused state proves menu or gameplay context",
      "when Tearscape creates attack2 for co-op every pad remains on the native device-aware path",
      "Godot main loop presents frames and publishes health",
      "SELECT+START requests the normal lifecycle exit"
    ],
    "source_evidence": [
      "ports/tearscape/adapter-env.sh",
      "ports/tearscape/src/nxinput/nxc6_glue.c",
      "ports/tearscape/src/nxinput/nxinput_portmaster.c",
      "ports/tearscape/src/godot_engine/godot-4.6.1-nextos.patch",
      "ports/tearscape/src/godot_engine/v4-universal/drivers/sdl/joypad_sdl.cpp",
      "ports/tearscape/src/godot_engine/v4-universal/drivers/sdl/nxinput_gptk_godot.cpp",
      "ports/tearscape/src/godot_engine/v4-universal/platform/linuxbsd/fbdev/display_server_fbdev.cpp"
    ]
  },
  "persistence": {
    "callbacks": [
      "Godot project save path under NXCOMPAT_HOME"
    ],
    "paths": [
      "saves",
      "NEXTOSCONTROLLERS.gptk",
      "NEXTOSSETTINGS.txt"
    ]
  },
  "prohibitions": [
    "never suppress native input before sink coverage and scene context are proven",
    "never replay a physical event natively after a sink ACK failure",
    "never synthesize start_coop or co-op player events because Tearscape derives P1/P2 from the physical event class and device",
    "never replace the proven GLES2 facade with native GLES3 on the universal path",
    "never bypass Godot main-loop lifecycle order"
  ],
  "quirks": [
    "Tearscape UI uses custom focus; UI scene paths and the UiManager-owned SceneTree paused state prove menu context",
    "player movement InputMap actions use the assembly-confirmed move_up move_down move_left move_right names",
    "system.pause delivers the assembly-confirmed menu action consumed by UiManager, not the unrelated pause action",
    "zoom_map is a button action; the generated default leaves RIGHT_STICK native and legacy owner stick mappings emit one radial edge",
    "NEXTOSCONTROLLERS governs one primary pad only outside co-op; additional pads and attack2 mode stay native",
    "every scene source or co-op transition releases GPTK latches and preserves physical state; old ACTION/null stays suppressed while old NONE/native stays native until release or stick center, including consecutive transitions",
    "Godot embeds the pinned SDL 3.2.30 joystick subset statically; input_sdl3_portmaster stays disabled because the ZIP carries no private libSDL shared object or PortMaster SDL provider"
  ],
  "release_ready": true,
  "schema": "nxadapter-skeleton-v1",
  "schema_version": 1,
  "status": "implemented_release",
  "terminal": {
    "action": "SELECT+START",
    "evidence": [
