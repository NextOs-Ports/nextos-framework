{
  "schema": 1,
  "id": "tearscape",
  "version": "2",
  "title": "Tearscape",
  "abi_order": [
    "arm64-v8a"
  ],
  "reference_build": {
    "game_version": "1.0.0",
    "version_code": 2,
    "container_size": 200616501,
    "container_sha256": "2a08b352ab25c38d01d1d59002cf1b68c69923d217961e88cbd9e42fcb93569a",
    "note": "documented containers: 1.0.0 (versionCode 2) and 1.0.1, both verified; compatibility is decided by capability (package family, required members, structural floors), so future builds that keep the Godot 4 Mono layout install without a recipe change"
  },
  "compatibility": {
    "package_families": [
      "com.nerdstakeover.tearscape"
    ],
    "abis": [
      "arm64-v8a"
    ],
    "required_members": [
      "assets/assets.sparsepck",
      "assets/project.binary",
      "assets/.godot/mono/publish/arm64/GodotSharp.dll",
      "assets/.godot/mono/publish/arm64/Tearscape.dll",
      "assets/.godot/mono/publish/arm64/Tearscape.runtimeconfig.json",
      "lib/arm64-v8a/libgodot_android.so"
    ],
    "payload_contracts": [
      "Godot 4 exported project tree",
      ".NET managed game assembly and GodotSharp 4.6.1 interface",
      "AArch64 Android engine member"
    ],
    "required_symbols_or_interfaces": [
      "Godot 4.6.1 Mono project.binary",
      ".NETCoreApp 10.0 arm64 runtime contract"
    ]
  },
  "input": {
    "search_dirs": [
      "gamedata",
      "."
    ],
    "prefer_first_nonempty": true,
    "sniff_all_in_primary": true,
    "extensions": [
      ".apk",
      ".apkm",
      ".apks",
      ".xapk"
    ],
    "packages": [
      "com.nerdstakeover.tearscape"
    ]
  },
  "extract": [
    {
      "id": "godot-project-data",
      "source": {
        "kind": "entries",
        "patterns": [
          "assets/.godot/exported/**",
          "assets/.godot/imported/**",
          "assets/.godot/global_script_class_cache.cfg",
          "assets/.godot/uid_cache.bin",
          "assets/.godot/mono/publish/arm64/.dotnet-publish-manifest",
          "assets/.godot/mono/publish/arm64/GodotSharp.dll",
          "assets/.godot/mono/publish/arm64/Tearscape.dll",
          "assets/.godot/mono/publish/arm64/Tearscape.runtimeconfig.json",
          "assets/addons/**",
          "assets/audio/**",
          "assets/scenes/**",
          "assets/shaders/**",
          "assets/sprites/**",
          "assets/src/**",
          "assets/strings/**",
          "assets/ui/**",
          "assets/assets.sparsepck",
          "assets/default_bus_layout.tres.remap",
          "assets/icon.svg",
          "assets/icon.svg.import",
          "assets/icudt_godot.dat",
          "assets/NTO_logo.png",
          "assets/NTO_logo.png.import",
          "assets/project.binary"
        ],
        "scopes": [
          "apk",
          "bundle"
        ],
        "strip_prefix": "assets/",
        "case_sensitive": true
      },
      "destination": "game",
      "source_validate": {
        "type": "tree",
        "required_paths": [
          "assets.sparsepck",
          "project.binary",
          ".godot/mono/publish/arm64/GodotSharp.dll",
          ".godot/mono/publish/arm64/Tearscape.dll",
          ".godot/mono/publish/arm64/Tearscape.runtimeconfig.json"
        ],
        "min_files": 1000,
        "max_files": 60000,
        "min_bytes": 40000000,
        "max_bytes": 1200000000
      }
    }
  ],
  "validate": [
    {
      "path": "game/assets.sparsepck",
      "type": "file",
      "min_size": 302518
    },
    {
      "path": "game/project.binary",
      "type": "file",
      "min_size": 21700
    },
    {
      "path": "game/.godot/mono/publish/arm64/GodotSharp.dll",
      "type": "file",
      "min_size": 4614144
    },
    {
      "path": "game/.godot/mono/publish/arm64/Tearscape.dll",
      "type": "file",
      "min_size": 1653555
    },
    {
      "path": "game/.godot/mono/publish/arm64/Tearscape.runtimeconfig.json",
      "type": "file",
      "min_size": 287
    }
  ],
  "commit": [
    "game/.godot/exported",
    "game/.godot/global_script_class_cache.cfg",
    "game/.godot/imported",
    "game/.godot/mono/publish/arm64/.dotnet-publish-manifest",
    "game/.godot/mono/publish/arm64/GodotSharp.dll",
    "game/.godot/mono/publish/arm64/Tearscape.dll",
    "game/.godot/mono/publish/arm64/Tearscape.runtimeconfig.json",
    "game/.godot/uid_cache.bin",
    "game/addons",
    "game/assets.sparsepck",
    "game/audio",
    "game/default_bus_layout.tres.remap",
    "game/icon.svg",
    "game/icon.svg.import",
    "game/icudt_godot.dat",
    "game/NTO_logo.png",
    "game/NTO_logo.png.import",
    "game/project.binary",
    "game/scenes",
    "game/shaders",
    "game/sprites",
    "game/src",
    "game/strings",
    "game/ui"
  ],
  "hooks": [
    {
      "id": "camera-touch-thresholds",
      "argv": [
        "python3",
        "{recipe_dir}/nxextract/patch-camera-touch-thresholds.py",
        "{stage}/game/.godot/mono/publish/arm64/Tearscape.dll"
      ],
      "cwd": "{stage}",
      "checkpoint": [
        {
          "path": "game/.godot/mono/publish/arm64/Tearscape.dll",
          "type": "file",
          "min_size": 1653555
        }
      ],
      "contract": {
        "schema": "org.nextos.apk-compat.hook-contract",
        "schema_version": 1,
        "hook_id": "camera-touch-thresholds",
        "inputs": [
          "game/.godot/mono/publish/arm64/Tearscape.dll"
        ],
        "predicates": [
          {
            "class": "compatibility",
            "checks": "The managed game assembly exposes the Camera.TrackTarget non-touch branch selector as the byte sequence 'ldc.r4 9; div; stloc.3; ldarg.0; ldfld _isTouchMode; brtrue.s' exactly once; the hook rewrites only that single selector to force the proportional (touch) room-transition thresholds and re-verifies the rewritten bytes before committing."
          }
        ],
        "fallback": "leave_native_camera",
        "error_codes": [
          "NXCAM_APPLIED",
          "NXCAM_ALREADY_APPLIED",
          "NXCAM_SIGNATURE_ABSENT_SKIP",
          "NXCAM_SELFCHECK_FAILED"
        ]
      }
    }
  ],
  "marker": ".nxextract-tearscape.json",
  "space": {
    "safety_bytes": 268435456
  },
  "log": "nxextract.log",
  "detail_log": "nxextract-detail.log",
  "ui_success_seconds": 1,
  "ui_error_seconds": 5
}
