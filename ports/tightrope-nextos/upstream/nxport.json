{
  "architecture": "aarch64",
  "argument_mode": "game-dir-and-passthrough",
  "enabled_quirks": [
    "adapter.exit-chord-evdev-fallback"
  ],
  "executable": "tightrope-nextos",
  "home_mode": "preserve",
  "id": "tightrope",
  "launcher_name": "Tightrope Theatre.sh",
  "nxextract": {
    "mode": "yes",
    "version": "1.2.12"
  },
  "prepare_script": "prepare.sh",
  "private_library_paths": [],
  "required_capabilities": [
    "host.portmaster",
    "host.aarch64-libs",
    "graphics.window",
    "graphics.gles2",
    "graphics.egl",
    "graphics.egl-config",
    "graphics.drawable",
    "audio.output-open",
    "input.controller-mapping",
    "input.controller-api",
    "audio.embedded-openal"
  ],
  "required_files": [
    "tightrope-nextos",
    "nxsplash-nextos",
    "lib/liblime.so",
    "lib/libApplicationMain.so",
    "tools/patches/liblime.xormask",
    "tools/patches/libApplicationMain.xormask",
    "assets/manifest/default.json"
  ],
  "runtime_report": "log-and-logo",
  "schema_version": 2,
  "title": "Tightrope Theatre"
}
