{
  "schema": "nxadapter-contract-v1",
  "schema_version": 1,
  "port_id": "gunbrick",
  "engine": "Unity 2022.3 IL2CPP",
  "architecture": "aarch64",
  "status": "physically-validated-release",
  "release_ready": true,
  "lifecycle": {
    "policy": "preserve_native_android_order",
    "sequence": [
      "load-libmain",
      "load-libunity",
      "load-libil2cpp",
      "relocate-local",
      "resolve-strict",
      "init-arrays",
      "jni-onload-1.6",
      "native-loader-readiness",
      "init-jni",
      "surface-created",
      "surface-changed",
      "focus-gained",
      "resume",
      "render-loop",
      "focus-lost",
      "pause"
    ]
  },
  "input": {
    "implementation": "nxinput",
    "mapping": "PortMaster control mapping through the native Android controller API",
    "optional_quirk": "game.gunbrick.swipe-input",
    "optional_quirk_enabled": false,
    "left_stick": {
      "policy": "native-raw-two-axis",
      "host_cardinal_filter": false,
      "bonus_3d_quadrants_preserved": true,
      "native_rewired_path_preserved": true
    }
  },
  "graphics": {
    "selection": "capability-first",
    "primary": "sdl-gles2",
    "fallback": "raw-egl-after-real-failure",
    "forced_backend_environment": false,
    "global_alpha_override": false,
    "global_texture_wrap_override": false
  },
  "physical_device_evidence": true,
  "physical_baseline_release": "0.2.5",
  "memory_ownership": {
    "jni_reference_policy": "scoped-refcounted-local-frames",
    "jni_local_scope_regression": 100000,
    "jni_live_after_regression": 0,
    "guest_semaphore_registry": "dynamic-stable-address-map",
    "guest_sem_destroy_policy": "non-destructive-for-engine-pointer-safety",
    "host_semaphore_regression": 4096,
    "repeated_post_wait_regression": 100000,
    "android_low_memory_callback": {
      "thread": "UnityMain-before-nativeRender",
      "poll_frames": 120,
      "mem_available_kib": 131072,
      "swap_free_kib": 65536,
      "cooldown_frames": 900
    },
    "guest_text_residency": "file-backed-clean-rx"
  },
  "physical_baseline_evidence": [
    "nxextract-ui-visible-on-three-targets",
    "video-audio-controller-gameplay-on-three-targets",
    "ark-mali-g31-bonus-phase-3-transition-without-oom-on-0.2.5",
    "ark-mali-g31-raw-two-axis-left-stick-and-dpad-on-0.2.5",
    "ark-mali-g31-video-audio-controls-and-continued-gameplay-on-0.2.5"
  ],
  "prohibitions": [
    "no-RVA-patches",
    "no-lifecycle-shortcuts",
    "no-proprietary-data-in-public-package"
  ]
}
