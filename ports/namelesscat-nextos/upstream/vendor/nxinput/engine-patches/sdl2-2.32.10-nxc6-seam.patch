@@ -255,11 +256,64 @@
     return SDL_EVDEV_GuessDeviceClass(evbit, absbit, keybit, relbit);
 }
 
+/* V4-CONTROLLERS-03 / C6 -- capability sweep for stickless pads.
+ *
+ * SDL_EVDEV_GuessDeviceClass() only grants SDL_UDEV_DEVICE_JOYSTICK when the
+ * node carries an ABS_X+ABS_Y pair, so a controller that exposes only game
+ * buttons (gamepad cluster, D-pad keys, trigger-happy block) and at most a
+ * hat is invisible to the non-udev fallback -- the joystick list stays empty
+ * while the device is real and readable. udev's own input_id builtin tags
+ * ID_INPUT_JOYSTICK from those button ranges alone; this sweep restores the
+ * same capability-based answer where udev is not available. Only kernel
+ * capability bits are consulted: no device name, no GUID, no firmware
+ * identity. Mouse (BTN_MOUSE), digitizer (BTN_DIGI) and plain keyboard
+ * ranges never satisfy it. */
+#ifndef BTN_DPAD_UP
+#define BTN_DPAD_UP 0x220
+#endif
+#ifndef BTN_DPAD_RIGHT
+#define BTN_DPAD_RIGHT 0x223
+#endif
+#ifndef BTN_TRIGGER_HAPPY
+#define BTN_TRIGGER_HAPPY 0x2c0
+#endif
+#ifndef BTN_TRIGGER_HAPPY40
+#define BTN_TRIGGER_HAPPY40 0x2e7
+#endif
+static int NXC6_KeybitsCarryGameButtons(int fd)
+{
+    unsigned long keybit[NBITS(KEY_MAX)] = { 0 };
+    unsigned code;
+
+    if (ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(keybit)), keybit) < 0) {
+        return 0;
+    }
+    for (code = BTN_JOYSTICK; code < BTN_DIGI; ++code) {
+        if (test_bit(code, keybit)) {
+            return 1;
+        }
+    }
+    for (code = BTN_DPAD_UP; code <= BTN_DPAD_RIGHT; ++code) {
+        if (test_bit(code, keybit)) {
+            return 1;
+        }
+    }
+    for (code = BTN_TRIGGER_HAPPY; code <= BTN_TRIGGER_HAPPY40; ++code) {
+        if (test_bit(code, keybit)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
 static int GuessIsJoystick(int fd)
 {
     if (GuessDeviceClass(fd) & SDL_UDEV_DEVICE_JOYSTICK) {
         return 1;
     }
+    if (NXC6_KeybitsCarryGameButtons(fd)) {
+        return 1;
+    }
 
     return 0;
 }
@@ -507,6 +561,37 @@
         /* Need to increment the joystick count before we post the event */
         ++numjoysticks;
 
+        /* V4-CONTROLLERS-03 / C6 -- the seam boundary.
+         *
+         * This runs BEFORE SDL_PrivateJoystickAdded(), so before this device
+         * is announced, before it is classified and before it can be opened.
+         * A device the seam refuses is unlinked here and never existed as far
+         * as the application is concerned: that is what makes a refusal
+         * honest instead of a half-configured pad. */
+        {
+            char nxc6_guid[33];
+            SDL_JoystickGetGUIDString(item->guid, nxc6_guid, sizeof(nxc6_guid));
+            if (!nxc6_admit_before_announce_named((int)item->device_instance, nxc6_guid, item->path, item->name)) {
+                SDL_joylist_item *nxc6_prev = NULL, *nxc6_scan;
+                for (nxc6_scan = SDL_joylist; nxc6_scan; nxc6_scan = nxc6_scan->next) {
+                    if (nxc6_scan == item) {
+                        break;
+                    }
+                    nxc6_prev = nxc6_scan;
+                }
+                if (nxc6_prev) {
+                    nxc6_prev->next = item->next;
+                } else {
+                    SDL_joylist = item->next;
+                }
+                if (SDL_joylist_tail == item) {
+                    SDL_joylist_tail = nxc6_prev;
+                }
+                --numjoysticks;
+                FreeJoylistItem(item);
+                goto done;
+            }
+        }
         SDL_PrivateJoystickAdded(item->device_instance);
         goto done;
     }
@@ -561,6 +646,7 @@
     /* Need to decrement the joystick count before we post the event */
