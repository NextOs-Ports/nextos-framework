{
  "schema": 1,
  "id": "forager-nextos",
  "version": "apk-1.0.13-armv7-store-r2-flex",
  "title": "FORAGER",
  "abi_order": [
    "armeabi-v7a"
  ],
  "input": {
    "search_dirs": [
      "gamedata",
      "."
    ],
    "prefer_first_nonempty": true,
    "sniff_all_in_primary": true,
    "packages": [
      "com.humblebundle.forager"
    ],
    "max_files": 32,
    "max_bundle_apks": 32,
    "max_member_bytes": 268435456,
