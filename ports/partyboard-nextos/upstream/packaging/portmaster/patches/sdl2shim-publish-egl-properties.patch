diff --git a/src/video/sdl2/SDL_sdl2opengles.c b/src/video/sdl2/SDL_sdl2opengles.c
index 1111111..2222222 100644
--- a/src/video/sdl2/SDL_sdl2opengles.c
+++ b/src/video/sdl2/SDL_sdl2opengles.c
@@ -30,6 +30,23 @@
 #define SDL2_GL_STENCIL_SIZE          7
 #define SDL2_GL_DOUBLEBUFFER          5
 
+#define SDL_PROP_WINDOW_SDL2_BACKEND_WINDOW_POINTER "SDL.window.sdl2_backend.window"
+#define SDL_PROP_WINDOW_SDL2_BACKEND_CONTEXT_POINTER "SDL.window.sdl2_backend.context"
+#define SDL_PROP_WINDOW_SDL2_BACKEND_EGL_DISPLAY_POINTER "SDL.window.sdl2_backend.egl_display"
+#define SDL_PROP_WINDOW_SDL2_BACKEND_EGL_SURFACE_POINTER "SDL.window.sdl2_backend.egl_surface"
+#define SDL_PROP_WINDOW_SDL2_BACKEND_GL_GET_PROC_POINTER "SDL.window.sdl2_backend.gl_get_proc"
+#define SDL_PROP_WINDOW_SDL2_BACKEND_GL_MAKE_CURRENT_POINTER "SDL.window.sdl2_backend.gl_make_current"
+#define SDL_PROP_WINDOW_SDL2_BACKEND_GL_SWAP_WINDOW_POINTER "SDL.window.sdl2_backend.gl_swap_window"
+#define SDL_PROP_WINDOW_SDL2_BACKEND_EGL_MAKE_CURRENT_POINTER "SDL.window.sdl2_backend.egl_make_current"
+#define SDL2_EGL_DRAW 0x3059
+
+typedef void *(*SDL2_GL_GetProcAddress_Fn)(const char *);
+typedef int (*SDL2_GL_MakeCurrent_Fn)(void *, void *);
+typedef void (*SDL2_GL_SwapWindow_Fn)(void *);
+typedef void *(*SDL2_EGL_GetCurrentDisplay_Fn)(void);
+typedef void *(*SDL2_EGL_GetCurrentSurface_Fn)(int);
+typedef unsigned int (*SDL2_EGL_MakeCurrent_Fn)(void *, void *, void *, void *);
+
 bool SDL2_GLES_LoadLibrary(SDL_VideoDevice *_this, const char *path)
 {
     if (!SDL2_GL_SetAttribute) {
@@ -119,5 +136,54 @@ SDL_GLContext SDL2_GLES_CreateContext(SDL_VideoDevice *_this, SDL_Window *window
     }
 
     data->sdl2_gl_context = ctx;
+
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    SDL_SetPointerProperty(props, SDL_PROP_WINDOW_SDL2_BACKEND_WINDOW_POINTER, data->sdl2_window);
+    SDL_SetPointerProperty(props, SDL_PROP_WINDOW_SDL2_BACKEND_CONTEXT_POINTER, data->sdl2_gl_context);
+    SDL_SetPointerProperty(props, SDL_PROP_WINDOW_SDL2_BACKEND_GL_GET_PROC_POINTER,
+                           (void *)(SDL2_GL_GetProcAddress_Fn)SDL2_GL_GetProcAddress);
+    SDL_SetPointerProperty(props, SDL_PROP_WINDOW_SDL2_BACKEND_GL_MAKE_CURRENT_POINTER,
+                           (void *)(SDL2_GL_MakeCurrent_Fn)SDL2_GL_MakeCurrent);
+    SDL_SetPointerProperty(props, SDL_PROP_WINDOW_SDL2_BACKEND_GL_SWAP_WINDOW_POINTER,
+                           (void *)(SDL2_GL_SwapWindow_Fn)SDL2_GL_SwapWindow);
+    if (SDL2_GL_MakeCurrent) {
+        SDL2_GL_MakeCurrent(data->sdl2_window, ctx);
+    }
+
+    void *egl_display = NULL;
+    void *egl_surface = NULL;
+    if (SDL2_EGL_GetCurrentDisplay) {
+        egl_display = SDL2_EGL_GetCurrentDisplay();
+    }
+    if (SDL2_EGL_GetWindowSurface) {
+        egl_surface = SDL2_EGL_GetWindowSurface(data->sdl2_window);
+    }
+    if ((!egl_display || !egl_surface) && SDL2_GL_GetProcAddress) {
+        SDL2_EGL_GetCurrentDisplay_Fn egl_get_current_display =
+            (SDL2_EGL_GetCurrentDisplay_Fn)SDL2_GL_GetProcAddress("eglGetCurrentDisplay");
+        SDL2_EGL_GetCurrentSurface_Fn egl_get_current_surface =
+            (SDL2_EGL_GetCurrentSurface_Fn)SDL2_GL_GetProcAddress("eglGetCurrentSurface");
+        if (!egl_display && egl_get_current_display) {
+            egl_display = egl_get_current_display();
+        }
+        if (!egl_surface && egl_get_current_surface) {
+            egl_surface = egl_get_current_surface(SDL2_EGL_DRAW);
+        }
+    }
+    if (SDL2_GL_GetProcAddress) {
+        SDL2_EGL_MakeCurrent_Fn egl_make_current =
+            (SDL2_EGL_MakeCurrent_Fn)SDL2_GL_GetProcAddress("eglMakeCurrent");
+        if (egl_make_current) {
+            SDL_SetPointerProperty(props, SDL_PROP_WINDOW_SDL2_BACKEND_EGL_MAKE_CURRENT_POINTER,
+                                   (void *)egl_make_current);
+        }
+    }
+    if (egl_display) {
+        SDL_SetPointerProperty(props, SDL_PROP_WINDOW_SDL2_BACKEND_EGL_DISPLAY_POINTER, egl_display);
+    }
+    if (egl_surface) {
+        SDL_SetPointerProperty(props, SDL_PROP_WINDOW_SDL2_BACKEND_EGL_SURFACE_POINTER, egl_surface);
+    }
+
     return (SDL_GLContext)ctx;
 }
 
