{
  "schema": 1,
  "id": "chrono-nextos",
  "version": "2.x-universal-2",
  "title": "CHRONO TRIGGER",
  "abi_order": [
    "arm64-v8a"
  ],
  "input": {
    "search_dirs": [
      "gamedata",
      "."
    ],
    "prefer_first_nonempty": true,
    "sniff_all_in_primary": true,
    "max_files": 64,
    "max_bundle_apks": 64,
    "max_member_bytes": 3221225472,
    "max_bundle_bytes": 6442450944
  },
  "extract": [
    {
      "id": "android-cocos-assets",
      "source": {
        "kind": "entries",
        "patterns": [
          "assets/*.dat",
          "assets/resources.bin",
          "assets/build_date.txt",
          "assets/Shaders/*.vsh",
          "assets/Shaders/*.fsh"
        ],
        "strip_prefix": "assets/"
      },
      "destination": "assets",
      "validate": {
        "type": "tree",
        "min_files": 8,
        "max_files": 96,
        "min_bytes": 300000000,
        "max_bytes": 1600000000,
        "required_paths": [
          "resources.bin",
          "001.dat",
          "Shaders/example_Simple.vsh"
        ]
      }
    },
    {
      "id": "android-engine-library",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libchrono.so"
        ]
      },
      "destination": "libchrono.so",
      "validate": {
        "type": "file",
        "elf_machine": "{abi}",
        "min_size": 6000000,
        "max_size": 48000000
      }
    },
    {
      "id": "android-libcxx",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libc++_shared.so"
        ]
      },
      "destination": "libc++_shared.so",
      "validate": {
        "type": "file",
        "elf_machine": "{abi}",
        "min_size": 400000,
        "max_size": 8000000
      }
    },
    {
      "id": "android-asset-cipher",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libencrypt.so"
        ]
      },
      "destination": "libencrypt.so",
      "validate": {
        "type": "file",
        "elf_machine": "{abi}",
        "min_size": 1024,
        "max_size": 262144
      }
    }
  ],
  "hooks": [],
  "validate": [
    {
      "path": "libchrono.so",
      "type": "file",
      "elf_machine": "arm64-v8a",
      "min_size": 6000000,
      "max_size": 48000000
    },
    {
      "path": "libc++_shared.so",
      "type": "file",
      "elf_machine": "arm64-v8a",
      "min_size": 400000,
      "max_size": 8000000
    },
    {
      "path": "assets/resources.bin",
      "type": "file",
      "min_size": 200000000,
      "max_size": 1200000000
    },
    {
      "path": "assets/001.dat",
      "type": "file",
      "min_size": 1000000,
      "max_size": 200000000
    },
    {
      "path": "assets/Shaders/example_Simple.vsh",
      "type": "file",
      "min_size": 100,
      "max_size": 8192
    }
  ],
  "commit": [
    "assets",
    "libchrono.so",
    "libc++_shared.so",
    "libencrypt.so"
  ],
  "marker": ".nxextract-chrono.json",
  "space": {
    "safety_bytes": 268435456
  },
  "log": "nxextract.log",
  "ui_success_seconds": 1,
  "ui_error_seconds": 8
}
