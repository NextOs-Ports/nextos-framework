{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextos.local/schemas/portmaster/port-json-supported-v2.schema.json",
  "title": "PortMaster metadata accepted by the NextOS release gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "items", "items_opt", "attr"],
  "properties": {
    "version": {"type": "integer", "minimum": 1, "maximum": 4},
    "name": {
      "type": "string",
      "minLength": 5,
      "pattern": "^[^/\\\\]+[.]zip$"
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/item"}
    },
    "items_opt": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/item"}
    },
    "attr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "arch", "min_glibc"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "desc": {"type": "string"},
        "inst": {"type": "string"},
        "genres": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "porter": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "image": {"type": "object"},
        "rtr": {"type": "boolean"},
        "exp": {"type": "boolean"},
        "runtime": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1},
            {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          ]
        },
        "min_glibc": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+(?:[.][0-9]+)?$"
        },
        "reqs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "arch": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.+-]+$"}
        }
      }
    },
    "status": {"type": "object"},
    "files": {"type": "object"},
    "source": {"oneOf": [{"type": "string"}, {"type": "object"}]},
    "md5": {"type": ["string", "null"]}
  },
  "$defs": {
    "item": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![.][.](?:/|$))(?!.*(?:^|/)[.][.](?:/|$))(?!.*\\\\)[^\\u0000]+$"
    }
  }
}
