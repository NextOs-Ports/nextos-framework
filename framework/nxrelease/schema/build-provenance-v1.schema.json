{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://nextos.local/schema/nxrelease-build-provenance-v1.json",
 "title": "NXRelease public-final build provenance v1",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "schema_version",
  "sanitized",
  "tool",
  "release",
  "sources",
  "builds",
  "comparison",
  "physical_receipts",
  "verdict"
 ],
 "properties": {
  "schema": {
   "const": "nxrelease-build-provenance-v1"
  },
  "schema_version": {
   "const": 1
  },
  "sanitized": {
   "const": true
  },
  "tool": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "version"
   ],
   "properties": {
    "name": {
     "const": "nxrelease"
    },
    "version": {
     "const": "0.3.21"
    }
   }
  },
  "release": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "package_id",
    "package_version",
    "port_commit",
    "zip_sha256",
    "zip_size",
    "generation_id",
    "generation_mode",
    "generation_receipt_sha256",
    "candidate_document_sha256",
    "candidate_executable",
    "candidate_executable_sha256"
   ],
   "properties": {
    "package_id": {
     "type": "string",
     "minLength": 1
    },
    "package_version": {
     "type": "string",
     "minLength": 1
    },
    "port_commit": {
     "type": "string",
     "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "zip_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "zip_size": {
     "type": "integer",
     "minimum": 1
    },
    "generation_id": {
     "$ref": "#/$defs/sha256"
    },
    "generation_mode": {
     "const": "embedded"
    },
    "generation_receipt_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "candidate_document_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "candidate_executable": {
     "type": "string",
     "minLength": 3
    },
    "candidate_executable_sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "maxItems": 1,
   "items": {
    "$ref": "#/$defs/source"
   }
  },
  "builds": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "prefixItems": [
    {"allOf": [
     {"$ref": "#/$defs/build"},
     {"properties": {"label": {"const": "tested"}}}
    ]},
    {"allOf": [
     {"$ref": "#/$defs/build"},
     {"properties": {"label": {"const": "rebuilt"}}}
    ]}
   ],
   "items": false
  },
  "comparison": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "archives_identical",
    "inventories_identical",
    "elfs_identical",
    "inventory",
    "elfs",
    "external_project_outputs"
   ],
   "properties": {
    "archives_identical": {
     "const": true
    },
    "inventories_identical": {
     "const": true
    },
    "elfs_identical": {
     "const": true
    },
    "inventory": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/inventory"
     }
    },
    "elfs": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object"
     }
    },
    "external_project_outputs": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "physical_receipts": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/physical"
   }
  },
  "verdict": {
   "const": "PUBLIC-FINAL-PASS"
  }
 },
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "label",
    "commit",
    "clean",
    "manifest",
    "manifest_sha256",
    "build_script"
   ],
   "properties": {
    "label": {
     "const": "source"
    },
    "commit": {
     "type": "string",
     "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "clean": {
     "const": true
    },
    "manifest": {
     "type": "string",
     "minLength": 1
    },
    "manifest_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "build_script": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "build": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "label",
    "zip_sha256",
    "zip_size"
   ],
   "properties": {
    "label": {
     "enum": [
      "tested",
      "rebuilt"
     ]
    },
    "zip_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "zip_size": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "inventory": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "kind",
    "mode",
    "sha256"
   ],
   "properties": {
    "path": {
     "type": "string",
     "minLength": 1
    },
    "kind": {
     "type": "string",
     "minLength": 1
    },
    "mode": {
     "enum": [
      "0644",
      "0755"
     ]
    },
    "sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "physical": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "device_id",
    "receipt_sha256",
    "run_id"
   ],
   "properties": {
    "device_id": {
     "type": "string",
     "minLength": 1
    },
    "receipt_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "run_id": {
     "type": "string",
     "minLength": 1
    }
   }
  }
 }
}
