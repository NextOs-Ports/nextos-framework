{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nextos:nxport:schema:2",
  "title": "NextOS universal port declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "launcher_name",
    "architecture",
    "executable",
    "nxextract"
  ],
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)(?:home|Users)/)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "relative_path_or_empty": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/relative_path"
        }
      ]
    },
    "execution_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "executable",
        "executor",
        "interpreter",
        "closure"
      ],
      "properties": {
        "architecture": {
          "enum": [
            "armv7",
            "aarch64",
            "i386",
            "x86_64"
          ]
        },
        "executable": {
          "$ref": "#/$defs/relative_path"
        },
        "executor": {
          "enum": [
            "native",
            "native-or-loader"
          ]
        },
        "interpreter": {
          "enum": [
            "/lib/ld-linux-armhf.so.3",
            "/lib/ld-linux-aarch64.so.1",
            "/lib/ld-linux.so.2",
            "/lib64/ld-linux-x86-64.so.2"
          ]
        },
        "closure": {
          "enum": [
            "host",
            "firmware",
            "firmware-and-port"
          ]
        }
      }
    },
    "helper_execution_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "architecture",
        "executable",
        "executor",
        "interpreter",
        "closure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "architecture": {
          "enum": [
            "armv7",
            "aarch64",
            "i386",
            "x86_64"
          ]
        },
        "executable": {
          "$ref": "#/$defs/relative_path"
        },
        "executor": {
          "enum": [
            "native",
            "native-or-loader"
          ]
        },
        "interpreter": {
          "enum": [
            "/lib/ld-linux-armhf.so.3",
            "/lib/ld-linux-aarch64.so.1",
            "/lib/ld-linux.so.2",
            "/lib64/ld-linux-x86-64.so.2"
          ]
        },
        "closure": {
          "enum": [
            "firmware",
            "firmware-and-port"
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "launcher_name": {
      "type": "string",
      "minLength": 4,
      "maxLength": 160,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f-\\u009f]+\\.sh$"
    },
    "architecture": {
      "enum": [
        "armv7",
        "aarch64",
        "i386",
        "x86_64"
      ]
    },
    "executable": {
      "$ref": "#/$defs/relative_path"
    },
    "argument_mode": {
      "enum": [
        "none",
        "passthrough",
        "game-dir",
        "game-dir-and-passthrough"
      ]
    },
    "home_mode": {
      "enum": [
        "preserve",
        "port"
      ]
    },
    "nxextract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "version"
      ],
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "yes",
            "no"
          ]
        },
        "version": {
          "const": "1.3.0"
        }
      }
    },
    "required_files": {
      "type": "array",
      "description": "Owner/runtime payload paths; the generator also inserts the executable and nxsplash-nextos.",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relative_path"
      }
    },
    "private_library_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relative_path"
      }
    },
    "sdl_provider": {
      "const": "system",
      "description": "Opt-in system SDL ownership; firmware roots precede PortMaster overlays without forcing an SDL backend."
    },
    "video_proof": {
      "const": "required",
      "description": "Require a run-bound OK video-proof receipt before a health-ready receipt can promote a generation."
    },
    "prepare_script": {
      "$ref": "#/$defs/relative_path_or_empty"
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(host|graphics|audio|input)\\.[a-z0-9][a-z0-9.-]{0,62}$",
        "enum": [
          "host.portmaster",
          "host.armhf-libs",
          "host.aarch64-libs",
          "host.i386-libs",
          "host.session-runtime",
          "host.short-memory",
          "host.fuse-like-filesystem",
          "host.network-filesystem",
          "host.fbdev",
          "host.drm",
          "host.drm-connected",
          "host.wayland",
          "host.x11",
          "audio.pulse-socket",
          "audio.pipewire-socket",
          "audio.alsa",
          "graphics.window",
          "graphics.gles2",
          "graphics.gles3",
          "graphics.egl",
          "graphics.egl-config",
          "graphics.drawable",
          "graphics.etc1",
          "graphics.etc2",
          "graphics.astc",
          "graphics.npot-full",
          "audio.output-open",
          "input.controller-mapping",
          "input.controller-api",
          "input.controller-connected",
          "input.hotplug",
          "audio.embedded-openal",
          "graphics.gles1"
        ]
      }
    },
    "enabled_quirks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(adapter|engine|game)\\.[a-z0-9][a-z0-9._-]{0,62}$"
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "supported"
      ],
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^(auto|[a-z]{2}(?:-[a-z0-9]{2,8})?)$"
        },
        "supported": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(?:-[a-z0-9]{2,8})?$"
          }
        }
      }
    },
    "options": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "values",
          "default",
          "environment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 /()+.,-]{0,63}$"
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,31}$"
            }
          },
          "default": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,31}$"
          },
          "environment": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        }
      }
    },
    "runtime_report": {
      "enum": [
        "log",
        "log-and-logo"
      ]
    },
    "execution_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extractor",
        "splash",
        "game",
        "helpers"
      ],
      "properties": {
        "extractor": {
          "anyOf": [
            {
              "$ref": "#/$defs/execution_role"
            },
            {
              "type": "null"
            }
          ]
        },
        "splash": {
          "$ref": "#/$defs/execution_role"
        },
        "game": {
          "$ref": "#/$defs/execution_role"
        },
        "helpers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/helper_execution_role"
          }
        }
      }
    }
  }
}
