{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextos.dev/schemas/nxbootstrap/phase-result-v1.json",
  "title": "nxbootstrap latest phase result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "nxbootstrap_version",
    "sequence",
    "run_id",
    "source",
    "phase",
    "boundary",
    "status",
    "reason_code",
    "child_status",
    "pid"
  ],
  "properties": {
    "schema": {
      "const": "org.nextos.nxbootstrap.phase-result"
    },
    "schema_version": {
      "const": 1
    },
    "nxbootstrap_version": {
      "const": "0.8.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}-[1-9][0-9]*$"
    },
    "source": {
      "enum": [
        "bootstrap",
        "extractor",
        "loader",
        "graphics",
        "audio",
        "input",
        "lifecycle",
        "diagnostic"
      ]
    },
    "phase": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "boundary": {
      "enum": ["START", "OK", "ERROR", "OBSERVED", "EXIT"]
    },
    "status": {
      "enum": ["begin", "ok", "failed", "observed"]
    },
    "reason_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "child_status": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 255
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    }
  }
}
