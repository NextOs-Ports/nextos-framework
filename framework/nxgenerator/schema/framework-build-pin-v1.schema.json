{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextos.invalid/schema/framework-build-pin-v1.schema.json",
  "title": "NextOS immutable framework build pin v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "tree_digest",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "nextos-framework-build-pin-v1"
    },
    "schema_version": {
      "const": 1
    },
    "tree_digest": {
      "const": "nxgenerator-component-tree-sha256-v1"
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "nxabi": {"$ref": "#/$defs/component"},
        "nxandroid": {"$ref": "#/$defs/component"},
        "nxaudio": {"$ref": "#/$defs/component"},
        "nxbootstrap": {"$ref": "#/$defs/component"},
        "nxcompat": {"$ref": "#/$defs/component"},
        "nxgenerator": {"$ref": "#/$defs/component"},
        "nxgl": {"$ref": "#/$defs/component"},
        "nxinput": {"$ref": "#/$defs/component"},
        "nxloader": {"$ref": "#/$defs/component"},
        "nxobs": {"$ref": "#/$defs/component"},
        "nxrelease": {"$ref": "#/$defs/component"},
        "nxsplash": {"$ref": "#/$defs/component"},
        "nxextract": {"$ref": "#/$defs/component"},
        "portmaster": {"$ref": "#/$defs/component"},
        "tests": {"$ref": "#/$defs/component"}
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit", "tree_sha256"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){2}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
