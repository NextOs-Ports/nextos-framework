{
  "schema": 1,
  "id": "scourgebringer-nextos",
  "version": "apk-1.61.x-flex-language-save-exit-r4",
  "title": "ScourgeBringer (APK 1.61.x: classic / blob)",
  "abi_order": ["arm64-v8a"],
  "input": {
    "packages": ["com.pid.scourgebringer"]
  },
  "extract": [
    {
      "id": "monogame-content",
      "source": {
        "kind": "entries",
        "patterns": ["assets/Content/*"],
        "strip_prefix": "assets/Content/"
      },
      "destination": "assets/Content",
      "validate": {
        "type": "tree",
        "min_files": 70,
        "max_files": 96,
        "min_bytes": 100000000,
        "max_bytes": 180000000,
        "required_paths": [
          "common_0.xnb",
          "feedback.xnb",
          "Sounds/Master.bank",
          "Sounds/Master.strings.bank",
          "Localizations/EN"
        ]
      }
    },
    {
      "id": "android-runtime-libraries",
      "source": {
        "kind": "entries",
        "patterns": [
          "lib/{abi}/libmonodroid.so",
          "lib/{abi}/libmonosgen-2.0.so",
          "lib/{abi}/libxamarin-app.so",
          "lib/{abi}/libfmod.so"
        ],
        "strip_prefix": "lib/{abi}/"
      },
      "destination": "runtime-libs",
      "validate": {
        "type": "tree",
        "min_files": 11,
        "max_files": 13,
        "min_bytes": 7500000,
        "max_bytes": 12000000,
        "required_paths": [
          "libmonosgen-2.0.so",
          "libmonodroid.so",
          "libxamarin-app.so",
          "libfmod.so"
        ]
      }
    },
    {
      "id": "android-assembly-container",
      "source": {"kind": "container"},
      "destination": "assemblies.apk",
      "validate": {"type": "file"}
    }
  ],
  "hooks": [
    {
      "id": "aligned-assembly-apk",
      "argv": [
        "python3",
        "{game_dir}/nxextract/make-assembly-apk.py",
        "{stage}/assemblies.apk",
        "{stage}/assemblies.apk"
      ],
      "checkpoint": [
        {
          "path": "assemblies.apk",
          "type": "file",
          "min_size": 1000000,
          "max_size": 8388608,
          "magic_ascii": "PK"
        }
      ]
    }
  ]
}
