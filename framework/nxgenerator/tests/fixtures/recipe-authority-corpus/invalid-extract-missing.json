{
 "schema": 1,
 "id": "meu-port",
 "version": "1",
 "title": "MEU NOVO PORT",
 "abi_order": [
  "arm64-v8a",
  "armeabi-v7a"
 ],
 "input": {
  "search_dirs": [
   "gamedata",
   "."
  ],
  "prefer_first_nonempty": true,
  "sniff_all_in_primary": true
 },
 "validate": [
  {
   "path": "lib/{abi}/libgame.so",
   "type": "file",
   "elf_machine": "{abi}"
  }
 ],
 "commit": [
  "lib/{abi}/libgame.so",
  "assets"
 ],
 "marker": ".nxextract-meu-port.json",
 "space": {
  "safety_bytes": 134217728
 },
 "log": "nxextract.log",
 "ui_success_seconds": 1,
 "ui_error_seconds": 5
}
