# NEXTOSCONTROLLERS — controles do NextOS / NextOS controls
# Formato próprio do NextOS. NÃO é gptokeyb: nunca vira teclado.
# NextOS own format. NOT gptokeyb: never becomes a keyboard.
#
# Edite as ações à direita para trocar os controles. A lista de ações
# válidas vem do adapter-contract.json do port. Este arquivo é SEU:
# atualizações do port nunca sobrescrevem a sua cópia editada.
# Edit the actions on the right to remap. Valid actions come from the
# port's adapter-contract.json. This file is YOURS: port updates never
# overwrite your edited copy.

format = NEXTOS_CONTROLLERS/4
port = fp2

CONTROL_STANDARD = xbox
GLYPH_STYLE = xbox
AUTHORITY = nextos
CONTEXT_POLICY = unified

# Positional Xbox surface: A = south, B = east, X = west, Y = north.
# One base map for title/menu/gameplay; [override.*] only where the game proved a screen diverges.
[base]
A = action:fp2.attack
B = action:fp2.jump
X = action:fp2.special
Y = action:fp2.guard
L1 = native
R1 = native
L3 = native
R3 = null
START = action:fp2.pause
SELECT = native
GUIDE = native
UP = native
DOWN = native
LEFT = native
RIGHT = native

[override.menu]
A = action:fp2.confirm
B = action:fp2.cancel
X = native
Y = native
stick.left.vector = native

[stick.left]
mode = vector
vector = action:fp2.move
up = null
down = null
left = null
right = null
enter_threshold = 0.55
exit_threshold = 0.40
diagonal = 8way
tie_break = horizontal

[stick.right]
mode = vector
vector = native
up = null
down = null
left = null
right = null
enter_threshold = 0.55
exit_threshold = 0.40
diagonal = 8way
tie_break = horizontal

[trigger.left]
mode = analog
analog = native
digital = null
enter_threshold = 0.55
exit_threshold = 0.40

[trigger.right]
mode = analog
analog = native
digital = null
enter_threshold = 0.55
exit_threshold = 0.40
