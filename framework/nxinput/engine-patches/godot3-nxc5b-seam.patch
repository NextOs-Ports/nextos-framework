--- a/nxc5b/nxc5b_glue.h
+++ b/nxc5b/nxc5b_glue.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#ifndef NXC5B_GLUE_H
+#define NXC5B_GLUE_H
+/* C5B seam glue for the executed Godot major. Called from
+ * JoypadLinux::open_joypad(), on the joypad thread, immediately BEFORE
+ * input->joy_connection_changed(). Returns true when the engine may announce
+ * the pad. */
+class InputDefault;
+bool nxc5b_admit_before_announce(InputDefault *p_input, int p_joy_id, int p_fd,
+		const char *p_guid, const char *p_name, const char *p_devpath);
+#endif
--- a/nxc5b/nxc5b_glue.cpp
+++ b/nxc5b/nxc5b_glue.cpp
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "nxc5b_glue.h"
+
+#include "main/input_default.h"
+
+extern "C" {
+#include "nxinput_godot_seam.h"
+}
+
+#include <linux/input.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+
+#define NXC5B_BPL (8u * (unsigned int)sizeof(unsigned long))
+#define NXC5B_KEY_WORDS ((NXINPUT_GODOT_KEY_BITS + NXC5B_BPL - 1u) / NXC5B_BPL)
+#define NXC5B_ABS_WORDS ((NXINPUT_GODOT_ABS_BITS + NXC5B_BPL - 1u) / NXC5B_BPL)
+
+namespace {
+
+int op_add_mapping(void *ud, const char *mapping) {
+	static_cast<InputDefault *>(ud)->add_joy_mapping(String::utf8(mapping), true);
+	return 0;
+}
+/* The seam passes the joy id, but the engine cannot key on it yet: at this
+ * point joy_names has no entry, because the announce has not happened. We
+ * resolve by the pad's uid, the same rule the engine uses at announce. */
+static String g_nxc5b_uid;
+int op_has_mapping(void *ud, int joy_id) {
+	(void)joy_id;
+	return static_cast<InputDefault *>(ud)->nx_has_mapping(g_nxc5b_uid) ? 1 : 0;
+}
+int op_readback(void *ud, int joy_id, int physical_button) {
+	(void)joy_id;
+	return static_cast<InputDefault *>(ud)->nx_readback_logical_button(g_nxc5b_uid, physical_button);
+}
+uint64_t op_now(void *) {
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+long op_pid(void *) { return (long)getpid(); }
+long op_tid(void *) { return (long)syscall(SYS_gettid); }
+void op_receipt(void *, const char *line) {
+	const char *path = getenv("NXC5B_RECEIPT");
+	print_line(String::utf8(line));
+	if (path && path[0]) {
+		FILE *f = fopen(path, "a");
+		if (f) { fprintf(f, "%s\n", line); fclose(f); }
+	}
+}
+
+} // namespace
+
+namespace {
+/* EVIOCGABS on the ENGINE's own fd. The kernel answers; nothing here is
+ * derived from the mapping's text. */
+static nxinput_godot_absinfo g_nxc5b_absinfo[NXINPUT_GODOT_ABS_BITS];
+
+static size_t nxc5b_read_absinfo(int p_fd, const unsigned long *p_abs_bits) {
+	memset(g_nxc5b_absinfo, 0, sizeof(g_nxc5b_absinfo));
+	size_t seen = 0;
+	for (unsigned int code = 0; code < NXINPUT_GODOT_ABS_MAX; code++) {
+		unsigned int word = code / (8u * (unsigned int)sizeof(unsigned long));
+		unsigned int bit = code % (8u * (unsigned int)sizeof(unsigned long));
+		if (!((p_abs_bits[word] >> bit) & 1ul)) {
+			continue;
+		}
+		struct input_absinfo ai;
+		memset(&ai, 0, sizeof(ai));
+		if (ioctl(p_fd, EVIOCGABS(code), &ai) < 0) {
+			continue;
+		}
+		g_nxc5b_absinfo[code].minimum = ai.minimum;
+		g_nxc5b_absinfo[code].maximum = ai.maximum;
+		g_nxc5b_absinfo[code].fuzz = ai.fuzz;
+		g_nxc5b_absinfo[code].flat = ai.flat;
+		g_nxc5b_absinfo[code].resolution = ai.resolution;
+		g_nxc5b_absinfo[code].present = 1;
+		seen++;
+	}
+	return seen;
+}
+} // namespace
+
+bool nxc5b_admit_before_announce(InputDefault *p_input, int p_joy_id, int p_fd,
+		const char *p_guid, const char *p_name, const char *p_devpath) {
+	const char *decl = getenv("NXC5B_DECLARATION");
+	if (!p_input || p_fd < 0) {
+		return true;
+	}
+	static unsigned long keys[NXC5B_KEY_WORDS];
+	static unsigned long abs_bits[NXC5B_ABS_WORDS];
+	memset(keys, 0, sizeof(keys));
+	memset(abs_bits, 0, sizeof(abs_bits));
+	/* Capabilities come from THIS pad's fd, the one the engine opened. */
+	if (ioctl(p_fd, EVIOCGBIT(EV_KEY, sizeof(keys)), keys) < 0 ||
+			ioctl(p_fd, EVIOCGBIT(EV_ABS, sizeof(abs_bits)), abs_bits) < 0) {
+		return decl && decl[0] ? false : true;
+	}
+
+	g_nxc5b_uid = String::utf8(p_guid ? p_guid : "");
+
+	nxinput_godot_seam_engine engine;
+	memset(&engine, 0, sizeof(engine));
+	engine.api_version = NXINPUT_GODOT_SEAM_API_VERSION;
+	engine.struct_size = sizeof(engine);
+	engine.userdata = p_input;
+	engine.major = (uint8_t)NXINPUT_GODOT_ENGINE_3;
+	engine.add_joy_mapping = op_add_mapping;
+	engine.has_mapping = op_has_mapping;
+	engine.readback_logical_button = op_readback;
+	engine.monotonic_ns = op_now;
+	engine.pid = op_pid;
+	engine.tid = op_tid;
+	engine.receipt = op_receipt;
+
+	nxinput_godot_seam_device device;
+	memset(&device, 0, sizeof(device));
+	device.api_version = NXINPUT_GODOT_SEAM_API_VERSION;
+	device.struct_size = sizeof(device);
+	device.joy_id = p_joy_id;
+	device.fd = p_fd;
+	snprintf(device.guid, sizeof(device.guid), "%s", p_guid ? p_guid : "");
+	snprintf(device.name, sizeof(device.name), "%s", p_name ? p_name : "");
+	snprintf(device.devpath, sizeof(device.devpath), "%s", p_devpath ? p_devpath : "");
+	device.key_bits = keys;
+	device.key_bit_count = NXINPUT_GODOT_KEY_BITS;
+	device.abs_bits = abs_bits;
+	device.abs_bit_count = NXINPUT_GODOT_ABS_BITS;
+	device.abs_info = g_nxc5b_absinfo;
+	device.abs_info_count = nxc5b_read_absinfo(p_fd, abs_bits)
+			? (size_t)NXINPUT_GODOT_ABS_BITS
+			: (size_t)0;
+
+	nxinput_godot_seam_result r =
+			nxinput_godot_seam_admit(&engine, &device, decl ? decl : "");
+	if (r == NXINPUT_GODOT_SEAM_ADMIT || r == NXINPUT_GODOT_SEAM_NO_DECLARATION) {
+		return true;
+	}
+	print_line(String::utf8("NXC5B-SEAM blocked: ") +
+			String::utf8(nxinput_godot_seam_result_name(r)));
+	return false;
+}
