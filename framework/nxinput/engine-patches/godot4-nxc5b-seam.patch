+/* NXC5B seam: see input.h. Reads the engine's own stored mapping. */
+/* The seam runs BEFORE joy_connection_changed, so joy_names has no entry yet.
+ * These resolve by uid with the SAME rule the engine applies at announce
+ * time, over the engine's own map_db. */
+int Input::nx_find_mapping_by_uid(const String &p_uid) {
+	for (int i = 0; i < map_db.size(); i++) {
+		if (map_db[i].uid == p_uid) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+int Input::nx_readback_logical_button(const String &p_uid, int p_button) {
+	int idx = nx_find_mapping_by_uid(p_uid);
+	if (idx < 0) {
+		return -1;
+	}
+	JoyEvent ev = _get_mapped_button_event(map_db[idx], (JoyButton)p_button);
+	if (ev.type != TYPE_BUTTON) {
+		return -1;
+	}
+	return ev.index;
+}
+
+bool Input::nx_has_mapping(const String &p_uid) {
+	return nx_find_mapping_by_uid(p_uid) >= 0;
+}
